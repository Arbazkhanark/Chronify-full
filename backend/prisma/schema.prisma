// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum GoalType {
  SHORT_TERM
  LONG_TERM
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TimeTableSource {
  MANUAL
  AI
}

enum AIIntent {
  DOUBT
  TIMETABLE
  MOTIVATION
}

enum AccountType {
  STUDENT
  MENTOR
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PostType {
  ACHIEVEMENT
  JOURNEY
  MILESTONE
  GENERAL
}

enum TaskStatus {
  PENDING // task bana hai par start nahi hua
  ONGOING // abhi chal raha hai
  COMPLETED // successfully done
  MISSED // time nikal gaya, nahi hua
  SKIPPED
  DELAYED
  RESCHEDULED
}

enum SessionStatus {
  STARTED
  COMPLETED
  ABANDONED
}

enum StudyIntensity {
  LIGHT // ~2 hrs
  MEDIUM // ~4 hrs
  HARD // ~6 hrs
  EXTREME // exam mode
}

enum FriendStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

// Profile visibility options
enum ProfileVisibility {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum FixedTimeType {
  COLLEGE
  OFFICE
  SCHOOL
  COMMUTE
  MEETING
  WORKOUT
  MEAL
  ENTERTAINMENT
  FREE
  FAMILY
  HEALTH
  OTHER
}

enum TimeSlotType {
  TASK
  FIXED
  BREAK
  COMMUTE
  FREE
  CLASS
  STUDY
  HEALTH
  PROJECT
  MEETING
  WORKOUT
  MEAL
  ENTERTAINMENT
  SLEEP
  OTHER
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum SocialPlatform {
  FACEBOOK
  TWITTER
  INSTAGRAM
  LINKEDIN
  YOUTUBE
  TIKTOK
  GITHUB
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  FREELANCE
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  SEASONAL
}

enum LocationType {
  ON_SITE
  REMOTE
  HYBRID
}

enum SleepType {
  REGULAR
  POWER_NAP
  RECOVERY
  EARLY
  LATE
}

enum SleepDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
  FAILED
}

enum GoalCategory {
  ACADEMIC
  PROFESSIONAL
  HEALTH
  PERSONAL
  SKILL_DEVELOPMENT
  FINANCIAL
  SOCIAL
  CREATIVE
}

enum TaskCategory {
  ACADEMIC
  PROFESSIONAL
  HEALTH
  PERSONAL
  LEARNING
  BREAK
  COMMUTE
  PROJECT
  SLEEP
}

enum ReactionType {
  LIKE
  LOVE
  SAD
  ANGRY
  HAHA
}

enum ReminderType {
  BEFORE_START // X minutes pehle
  AT_START // exactly start time pe
  AFTER_END // complete karne ke liye (1 hour grace mein)
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String?

  timezone    String      @default("Asia/Kolkata")
  accountType AccountType @default(STUDENT)
  verified    Boolean     @default(false)

  // 🔥 NEW: direct avatar for dashboard (avoids Profile join)
  avatarUrl String?

  // 🔥 DOMAIN / INTERESTS (ARRAY)
  fields    String[] // ["Tech", "Design"]
  subFields String[] // ["Backend Developer", "AI", "DevOps"]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastLogin DateTime? // Track last login time
  isOnline  Boolean   @default(false) // Track if the user is online or not

  profileVisibility ProfileVisibility @default(PUBLIC) // Who can see the user's profile?

  phoneNumber      String? // If required
  twoFactorEnabled Boolean @default(false) // To handle 2FA

  lastTimetableLockAt DateTime? // Track when user last locked timetable

  // 🔥 NEW: OAuth accounts linked to this user
  oauthAccounts OAuthAccount[]

  // Core
  goals      Goal[]
  tasks      Task[]
  streak     Streak?
  aiSessions AISession[]

  // Profile
  profile Profile?
  privacy PrivacySettings?

  // 🔔 Notification prefs
  playSound         Boolean @default(true)
  gracePeriod       Int     @default(60) // Minutes (60 = 1 hour)
  notifyBeforeTask  Int     @default(15) // kitne min pehle notify karna hai
  notifyAtTaskStart Boolean @default(true) // start pe notify?
  notifyAtTaskEnd   Boolean @default(true) // end pe notify?
  snoozeUntil       DateTime? // notification snooze

  // Social
  posts    Post[]
  reaction Reaction[]
  comments Comment[]

  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")

  // 🔥 SELF RELATION
  friendsAsUser   Friend[] @relation("UserAsOwner")
  friendsAsFriend Friend[] @relation("UserAsFriend")

  reminders     Reminder[]
  taskReminders TaskReminder[]

  // Push subscriptions for this user
  pushSubscriptions PushSubscription[]

  // Fixed times + sleep schedules + task feedback
  fixedTimes     FixedTime[]
  sleepSchedules SleepSchedule[]
  taskFeedbacks  TaskFeedback[]
}

// ============================================================================
// AUTH / OAUTH
// ============================================================================

model OAuthAccount {
  id         String        @id @default(uuid())
  userId     String
  provider   OAuthProvider
  providerId String // Provider's user id (Google "sub", GitHub "id")

  email     String?
  name      String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

// ============================================================================
// PROFILE
// ============================================================================

model Profile {
  id     String @id @default(uuid())
  userId String @unique

  userName   String        @unique
  avatarUrl  String?
  coverPhoto String?
  bio        String?
  dob        DateTime?
  profession String?
  hobbies    String[]
  socialLinks SocialLink[]

  // Location as separate fields
  city    String?
  state   String?
  country String?

  // 🔥 NEW: Education and Experience (LinkedIn-style)
  education  Education[]
  experience Experience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SocialLink {
  id        String         @id @default(uuid())
  profileId String
  platform  SocialPlatform
  url       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id])
}

model Education {
  id        String @id @default(uuid())
  profileId String

  // Basic Info
  institution String
  degree      String
  field       String?
  grade       String?

  // Duration
  startYear   String?
  endYear     String?
  startDate   DateTime?
  endDate     DateTime?

  // Extra details
  description String?
  location    String?
  activities  String?
  isCurrent   Boolean @default(false)

  // Ordering
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, order])
}

model Experience {
  id        String @id @default(uuid())
  profileId String

  // Basic Info
  role          String
  organization  String
  employmentType EmploymentType @default(FULL_TIME)
  locationType  LocationType   @default(ON_SITE)

  // Duration
  startDate     String?
  endDate       String?
  startDateTime DateTime?
  endDateTime   DateTime?
  isCurrent     Boolean   @default(false)

  // Extra details
  location    String?
  description String?
  skills      String[]
  companyUrl  String?
  companyLogo String?

  // Ordering
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, order])
}

model PrivacySettings {
  id     String @id @default(uuid())
  userId String @unique

  profilePublic   Boolean @default(true)
  timetablePublic Boolean @default(false)
  progressPublic  Boolean @default(true)

  user User @relation(fields: [userId], references: [id])
}

// ============================================================================
// SLEEP SCHEDULE
// ============================================================================

model SleepSchedule {
  id     String @id @default(uuid())
  userId String

  // Day-specific schedule
  day      SleepDay
  bedtime  String // Format: "23:00"
  wakeTime String // Format: "07:00"
  duration Int // In minutes
  isActive Boolean   @default(true)
  type     SleepType @default(REGULAR)
  notes    String?
  color    String    @default("#4B5563")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 🔥 One schedule per day per user
  @@unique([userId, day])
  @@index([userId])
  @@index([day])
  @@index([userId, type])
}

// ============================================================================
// GOALS
// ============================================================================

model Goal {
  id     String @id @default(uuid())
  userId String

  // Basic Info
  title       String
  description String?
  category    GoalCategory @default(ACADEMIC)
  priority    GoalPriority @default(MEDIUM)
  type        GoalType     @default(SHORT_TERM)
  status      GoalStatus   @default(NOT_STARTED)

  // Dates
  targetDate  DateTime?
  completedAt DateTime?

  // Progress Tracking
  progress       Float  @default(0) // 0-100
  totalHours     Int    @default(0)
  completedHours Int    @default(0)
  weeklyTarget   Int    @default(5)
  color          String @default("#3B82F6")

  // Subject/Field
  subject String?

  // Streak & Activity
  streak      Int      @default(0)
  lastUpdated DateTime @default(now())

  // Visibility
  isPublic Boolean @default(false)

  // Tags (Array)
  tags String[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User        @relation(fields: [userId], references: [id])
  milestones Milestone[]
  tasks      Task[]

  @@index([userId])
  @@index([status])
  @@index([targetDate])
  @@index([category])
  // 🔥 NEW: dashboard sort optimization
  @@index([userId, status, priority])
}

model Milestone {
  id             String  @id @default(uuid())
  goalId         String
  title          String
  description    String?
  completed      Boolean @default(false)
  targetDate     DateTime?
  progress       Float   @default(0)
  scheduledHours Int     @default(0)
  completedHours Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // Milestone can have multiple tasks
  tasks Task[] @relation("MilestoneTasks")

  @@index([goalId])
}

// ============================================================================
// TASKS
// ============================================================================

model Task {
  id      String  @id @default(uuid())
  goalId  String?
  userId  String

  title     String
  subject   String?
  notes     String?
  startTime String
  endTime   String
  duration  Int // Minutes
  priority  Priority     @default(MEDIUM)
  color     String       @default("#3B82F6")
  day       String
  type      TimeSlotType
  category  TaskCategory
  icon      String?

  // Linked to fixed time free periods
  fixedTimeId  String?
  isFreePeriod Boolean @default(false)

  // Goal tracking - milestone can have multiple tasks
  milestoneId String?

  status             TaskStatus @default(PENDING)
  isCompleted        Boolean    @default(false)
  completedAt        DateTime?
  lastStatusUpdateAt DateTime?

  // 🟢 STARTED AT
  startedAt DateTime?

  // 🟢 ACTUAL DURATION
  actualDuration Int?

  // 🟢 GRACE PERIOD HANDLING
  gracePeriodEndsAt DateTime?

  // Rescheduling
  isRescheduled     Boolean @default(false)
  rescheduledToTime String?
  rescheduledDay    String?
  rescheduledCount  Int     @default(0)

  taskReminders TaskReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal?      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation("MilestoneTasks", fields: [milestoneId], references: [id], onDelete: Cascade)
  fixedTime FixedTime? @relation(fields: [fixedTimeId], references: [id], onDelete: Cascade)

  feedback TaskFeedback?

  @@index([userId])
  @@index([day])
  @@index([status])
  @@index([startTime])
  @@index([goalId])
  @@index([fixedTimeId])
  // 🔥 NEW: dashboard queries
  @@index([userId, day, status])
  @@index([userId, completedAt])
  @@index([userId, updatedAt])
}

model TaskFeedback {
  id     String @id @default(uuid())
  taskId String @unique
  userId String

  focusLevel    Int // 1-10
  completedWell Boolean @default(true)
  notes         String?
  duration      Int? // Actually kitna time laga (minutes mein)

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// FIXED TIMES
// ============================================================================

model FixedTime {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?
  days        String[]
  startTime   String
  endTime     String
  type        FixedTimeType @default(OTHER)
  color       String        @default("#6B7280")
  isEditable  Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  freePeriods FreePeriod[]
  tasks       Task[]

  @@index([userId])
}

model FreePeriod {
  id          String @id @default(uuid())
  fixedTimeId String
  title       String @default("Free Period")
  startTime   String
  endTime     String
  duration    Int
  day         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fixedTime FixedTime @relation(fields: [fixedTimeId], references: [id], onDelete: Cascade)

  @@index([fixedTimeId])
  @@index([day])
}

// ============================================================================
// STREAK
// ============================================================================

model Streak {
  id     String @id @default(uuid())
  userId String @unique

  current    Int       @default(0)
  best       Int       @default(0)
  lastActive DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================================================
// AI SESSIONS
// ============================================================================

model AISession {
  id     String @id @default(uuid())
  userId String

  input    String
  response String
  intent   AIIntent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ============================================================================
// SOCIAL
// ============================================================================

model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  status     FriendRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender   User @relation("SentRequests", fields: [senderId], references: [id])
  receiver User @relation("ReceivedRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

model Friend {
  id String @id @default(uuid())

  userId   String
  friendId String
  status   FriendStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("UserAsOwner", fields: [userId], references: [id])
  friend User @relation("UserAsFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model Post {
  id      String   @id @default(uuid())
  userId  String
  content String
  image   String[]
  type    PostType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  reactions Reaction[]
  comments  Comment[]
}

model Reaction {
  id        String       @id @default(uuid())
  postId    String?
  commentId String?
  userId    String
  reaction  ReactionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@unique([commentId, userId])
}

model Comment {
  id        String    @id @default(uuid())
  postId    String
  userId    String
  content   String
  parentId  String?
  isDeleted Boolean   @default(false)
  editedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  reactions Reaction[]
}

// ============================================================================
// REMINDERS / PUSH
// ============================================================================

model TaskReminder {
  id       String @id @default(uuid())
  taskId   String
  userId   String
  remindAt DateTime
  type     ReminderType
  sent     Boolean  @default(false)
  sentAt   DateTime?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
  @@index([sent])
}

model Reminder {
  id       String   @id @default(uuid())
  userId   String
  message  String
  remindAt DateTime

  user User @relation(fields: [userId], references: [id])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String // FCM token (long string)
  platform  String   @default("web") // web, android, ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}